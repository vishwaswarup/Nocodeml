# Copy to .env and fill in. Real values live only in .env (git-ignored).
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_TEST_EMAIL_A=
SUPABASE_TEST_PASSWORD_A=
SUPABASE_TEST_EMAIL_B=
SUPABASE_TEST_PASSWORD_B=

# --- API settings (all optional locally; required in production, see docs/deploy.md) ---
# NOCODEML_ENV=production              hides /docs, requires https CORS origins, adds HSTS
# NOCODEML_CORS_ORIGINS=https://app.yourdomain.com     comma-separated, https only in production
# NOCODEML_TRUST_PROXY=1               only when behind a reverse proxy that appends X-Forwarded-For
# NOCODEML_TRAIN_TIMEOUT=600           seconds one training run may take
